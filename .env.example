# Copy to .env for local development. Never commit real values.

# Supabase Postgres, through the pooler in transaction mode (port 6543).
# Supabase dashboard -> Connect -> Transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Supabase project URL and a secret key, used only server-side for photo storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
PHOTO_BUCKET=template-photos

# Separate database for integration tests. Tests wipe the tables they use.
TEST_DATABASE_URL=
